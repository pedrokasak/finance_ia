# Porta do servidor web
APP_PORT=8080

# Configuração do banco
DB_PORT=5432
DB_HOST=postgres #localhost somente se rodar localmente sem Docker
DB_USER=financeuser
DB_PASSWORD=financepass
DB_NAME=financeapp

# URL completa para GORM
DATABASE_URL=postgres://financeuser:financepass@postgres:5432/financeapp?sslmode=disable

# Configuração do JWT
# Deve ser uma string secreta longa e complexa
# Use `openssl rand -hex 32` para gerar uma chave secreta segura
# Exemplo: `openssl rand -hex 32` gera uma string hexadecimal de 32 bytes
# Você pode usar qualquer string longa e complexa, mas é recomendado usar uma chave gerada aleatoriamente
# Certifique-se de manter essa chave em segredo e não expô-la
# A chave deve ser mantida em segredo e não deve ser compartilhada publicamente
JWT_SECRET=3f8e7c1a-2b4d-4e9a-8c2e-1f6d7e8a9b0c

# Configuração do servidor HTTP
# Define se o servidor deve manter conexões ativas (keep-alive)
# Se definido como true, o servidor manterá conexões ativas por um período especificado
KEEP_ALIVE=true
KEEP_ALIVE_TIMEOUT=30s

# Configuração do Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password