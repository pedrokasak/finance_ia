# ==============================================================================
# FinanceIA — Environment Variables Reference
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ==============================================================================

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=debug            # debug | release
APP_PORT=8080
APP_URL=http://localhost:5173   # Frontend URL (for Stripe redirect)

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DATABASE_URL=postgres://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME?sslmode=disable
DB_NAME=finance_ia
DB_USER=finance_user
DB_PASSWORD=CHANGE_ME_strong_password
DB_PORT=5432

# ── Authentication ─────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_at_least_32_chars_long_secret_key

# ── Redis Cache ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_redis_password@localhost:6379/0
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_PORT=6379

# ── RabbitMQ (Message Queue) ───────────────────────────────────────────────────
RABBITMQ_URL=amqp://finance_user:CHANGE_ME_rabbit_password@localhost:5672/
RABBITMQ_USER=finance_user
RABBITMQ_PASSWORD=CHANGE_ME_rabbit_password
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── Stripe (Payments) ─────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET

# Price IDs — configure in Stripe dashboard
STRIPE_PRICE_PREMIUM=price_REPLACE_PREMIUM_MONTHLY
STRIPE_PRICE_PREMIUM_YEARLY=price_REPLACE_PREMIUM_YEARLY
STRIPE_PRICE_PRO=price_REPLACE_PRO_MONTHLY
STRIPE_PRICE_PRO_YEARLY=price_REPLACE_PRO_YEARLY

# ── Google Gemini AI ───────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza_REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash-exp   # or gemini-1.5-flash

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
SMTP_HOST=localhost       # Use mailhog for dev, real SMTP for prod
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@financeapp.com

# ── Observability ──────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_password

# ── Security (optional) ────────────────────────────────────────────────────────
TRUSTED_PROXIES=127.0.0.1,::1
