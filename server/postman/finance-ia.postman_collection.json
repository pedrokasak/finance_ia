{
    "info": {
        "name": "FinanceIA API",
        "description": "Coleção completa de endpoints da API FinanceIA com scripts de teste automatizados.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "{{baseUrl}}"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "userId",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Register",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 201', () => pm.response.to.have.status(201));",
                                    "pm.test('Has user object', () => {",
                                    "  const json = pm.response.json();",
                                    "  pm.expect(json).to.have.property('id');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/user/register",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"first_name\": \"Pedro\",\n  \"last_name\": \"Silva\",\n  \"email\": \"pedro@test.com\",\n  \"password\": \"SecurePass123!\"\n}"
                        }
                    }
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Has token', () => {",
                                    "  const json = pm.response.json();",
                                    "  pm.expect(json.token).to.be.a('string').and.to.have.length.above(10);",
                                    "  pm.collectionVariables.set('token', json.token);",
                                    "  pm.collectionVariables.set('userId', json.user_id || '');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/auth/login",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"pedro@test.com\",\n  \"password\": \"SecurePass123!\"\n}"
                        }
                    }
                },
                {
                    "name": "Login — Invalid Credentials",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 401', () => pm.response.to.have.status(401));",
                                    "pm.test('Has error', () => {",
                                    "  pm.expect(pm.response.json()).to.have.property('error');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/auth/login",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"wrong@test.com\",\n  \"password\": \"wrong\"\n}"
                        }
                    }
                },
                {
                    "name": "Forgot Password",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/auth/forgot-password",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{ \"email\": \"pedro@test.com\" }"
                        }
                    }
                }
            ]
        },
        {
            "name": "Finance",
            "auth": {
                "type": "bearer",
                "bearer": [
                    {
                        "key": "token",
                        "value": "{{token}}"
                    }
                ]
            },
            "item": [
                {
                    "name": "Dashboard",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Dashboard schema valid', () => {",
                                    "  const j = pm.response.json();",
                                    "  pm.expect(j).to.have.all.keys('total_income','total_expenses','balance','savings_rate','health_score','health_level','category_breakdown','monthly_trend');",
                                    "  pm.expect(j.health_score).to.be.a('number').and.within(0, 1000);",
                                    "  pm.expect(['Bronze','Prata','Ouro','Platina','Diamante']).to.include(j.health_level);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/finance/dashboard"
                    }
                },
                {
                    "name": "Create Transaction (Income)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "pm.request.headers.add({ key: 'Idempotency-Key', value: pm.variables.replaceIn('{{$randomUUID}}') });"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 201', () => pm.response.to.have.status(201));",
                                    "pm.test('Transaction created', () => {",
                                    "  const j = pm.response.json();",
                                    "  pm.expect(j.id).to.be.a('string');",
                                    "  pm.expect(j.type).to.equal('income');",
                                    "  pm.expect(j.amount).to.equal(5000);",
                                    "  pm.collectionVariables.set('txId', j.id);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/finance/transactions",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"type\": \"income\",\n  \"amount\": 5000,\n  \"description\": \"Salário Mensal\",\n  \"date\": \"2026-02-01\"\n}"
                        }
                    }
                },
                {
                    "name": "Create Transaction (Expense)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "pm.request.headers.add({ key: 'Idempotency-Key', value: pm.variables.replaceIn('{{$randomUUID}}') });"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 201', () => pm.response.to.have.status(201));",
                                    "pm.test('Expense created', () => {",
                                    "  const j = pm.response.json();",
                                    "  pm.expect(j.type).to.equal('expense');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/finance/transactions",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"type\": \"expense\",\n  \"amount\": 1200,\n  \"description\": \"Aluguel\",\n  \"date\": \"2026-02-05\"\n}"
                        }
                    }
                },
                {
                    "name": "Create Transaction — Idempotency Duplicate",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "pm.request.headers.add({ key: 'Idempotency-Key', value: 'fixed-test-key-001' });"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 201 or 200 (idempotent)', () => {",
                                    "  pm.expect([200, 201]).to.include(pm.response.code);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/finance/transactions",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"type\": \"income\",\n  \"amount\": 999,\n  \"description\": \"Duplicate test\",\n  \"date\": \"2026-02-01\"\n}"
                        }
                    }
                },
                {
                    "name": "List Transactions",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Pagination metadata', () => {",
                                    "  const j = pm.response.json();",
                                    "  pm.expect(j).to.have.all.keys('data','total','page','limit');",
                                    "  pm.expect(j.data).to.be.an('array');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/finance/transactions?page=1&limit=10"
                    }
                },
                {
                    "name": "Delete Transaction",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "DELETE",
                        "url": "{{baseUrl}}/finance/transactions/{{txId}}"
                    }
                },
                {
                    "name": "List Categories",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array').and.not.empty);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/finance/categories"
                    }
                },
                {
                    "name": "Upsert Budget",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Budget percentages', () => {",
                                    "  const j = pm.response.json();",
                                    "  pm.expect(j.needs_percent).to.equal(50);",
                                    "  pm.expect(j.wants_percent).to.equal(30);",
                                    "  pm.expect(j.savings_percent).to.equal(20);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/finance/budget",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"total_income\": 5000,\n  \"needs_percent\": 50,\n  \"wants_percent\": 30,\n  \"savings_percent\": 20\n}"
                        }
                    }
                },
                {
                    "name": "Behavioral Analysis",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Analysis schema', () => {",
                                    "  const j = pm.response.json();",
                                    "  pm.expect(j).to.have.all.keys('emotional_spending_score','weekend_vs_weekday_ratio','impulse_purchase_count','money_leak_categories','risk_level','risk_message');",
                                    "  pm.expect(['low','medium','high']).to.include(j.risk_level);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/finance/behavior"
                    }
                }
            ]
        },
        {
            "name": "AI",
            "auth": {
                "type": "bearer",
                "bearer": [
                    {
                        "key": "token",
                        "value": "{{token}}"
                    }
                ]
            },
            "item": [
                {
                    "name": "Get Insight (Free Plan)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200 or 429', () => {",
                                    "  pm.expect([200, 429]).to.include(pm.response.code);",
                                    "});",
                                    "if (pm.response.code === 200) {",
                                    "  pm.test('Insight schema', () => {",
                                    "    const j = pm.response.json();",
                                    "    pm.expect(j).to.have.all.keys('id','type','title','content','plan','generated_at','expires_at');",
                                    "    pm.expect(['warning','tip','achievement','projection']).to.include(j.type);",
                                    "  });",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/ai/insight"
                    }
                },
                {
                    "name": "Get Health Score",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Health score valid', () => {",
                                    "  const j = pm.response.json();",
                                    "  pm.expect(j.score).to.be.a('number').and.within(0,1000);",
                                    "  pm.expect(['Bronze','Prata','Ouro','Platina','Diamante']).to.include(j.level);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/ai/health-score"
                    }
                },
                {
                    "name": "Full Analysis — Free Plan (403)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 403 for free plan', () => pm.response.to.have.status(403));",
                                    "pm.test('Has upgrade flag', () => pm.expect(pm.response.json().upgrade).to.be.true);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/ai/analysis"
                    }
                }
            ]
        },
        {
            "name": "Subscription",
            "auth": {
                "type": "bearer",
                "bearer": [
                    {
                        "key": "token",
                        "value": "{{token}}"
                    }
                ]
            },
            "item": [
                {
                    "name": "Get My Subscription",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Has plan', () => {",
                                    "  const j = pm.response.json();",
                                    "  pm.expect(['free','premium','pro']).to.include(j.plan || (j.subscription && j.subscription.plan));",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/subscription/"
                    }
                },
                {
                    "name": "Create Checkout",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Has checkout URL', () => {",
                                    "  const j = pm.response.json();",
                                    "  pm.expect(j.url).to.be.a('string').and.match(/^https:\\/\\/checkout\\.stripe\\.com/);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/subscription/checkout",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"plan\": \"premium\",\n  \"billing_type\": \"monthly\"\n}"
                        }
                    }
                }
            ]
        },
        {
            "name": "Health Check",
            "item": [
                {
                    "name": "Health",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Status ok', () => pm.expect(pm.response.json().status).to.equal('ok'));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/health"
                    }
                }
            ]
        }
    ]
}